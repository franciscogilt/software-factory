DATABASE_URL=postgres://factory:factory@localhost:5432/factory
AUTH_SECRET=generate-with-openssl-rand-base64-32
# 32 random bytes in base64: openssl rand -base64 32
MFA_ENCRYPTION_KEY=
# Optional: enable Google sign-in
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email sign-in links (local: Mailpit on port 1025)
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=Factory <no-reply@example.test>
# Monitoring: /api/metrics needs this bearer token (closed if empty). Alerts go to ALERT_EMAIL (disabled if empty).
METRICS_TOKEN=
ALERT_EMAIL=
